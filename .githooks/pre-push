#!/usr/bin/env bash
set -eu

ROOT_DIR="$(git rev-parse --show-toplevel)"

# Pre-push receives one line per ref being pushed on stdin:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# Two shapes of push modify no branch's contents and so do not need the
# current-branch check, and (delete-only) also need no validation-state check:
#   tag-only   — every remote_ref is under refs/tags/
#   delete-only — every local_sha is all zeros, git's marker for a deletion
# Otherwise run the protected-branch and validation-state checks.
PUSH_REFS="$(cat || true)"
TAG_ONLY=true
DELETE_ONLY=true
HAS_ANY_REF=false

while IFS=' ' read -r _local_ref local_sha remote_ref _remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  HAS_ANY_REF=true
  case "$remote_ref" in
    refs/tags/*) ;;
    *) TAG_ONLY=false ;;
  esac
  # An absent or non-zero local sha means something is being written, not deleted.
  case "${local_sha:-}" in
    ""|*[!0]*) DELETE_ONLY=false ;;
  esac
done <<EOF
$PUSH_REFS
EOF

# Authoritative check: does any ref being pushed target a protected branch?
# This runs first and unconditionally. Tag refs pass it by construction, so it
# needs no tag-only guard of its own.
printf '%s\n' "$PUSH_REFS" | "$ROOT_DIR/.ai-policy/scripts/check-push-refs.sh"

# Usability check: are we standing on a protected branch? Narrower than the
# check above and kept for the plain `git push` case, where no refspec is
# given and the target is implied by the current branch.
#
# Skipped for tag-only and delete-only pushes. A delete-only push writes to no
# branch, and the check above has already rejected it if any deleted ref were
# protected, so what reaches here removes unprotected refs only. Post-merge
# cleanup runs from the protected branch by nature: you switch back to it,
# then delete the merged branch. Asking where the pusher stands rejects that.
if [ "$HAS_ANY_REF" = "false" ] ||
  { [ "$TAG_ONLY" = "false" ] && [ "$DELETE_ONLY" = "false" ]; }; then
  "$ROOT_DIR/.ai-policy/scripts/check-protected-branch.sh"
fi

# shellcheck disable=SC1091
. "$ROOT_DIR/.ai-policy/policy.env"

if [ "$REQUIRE_VALIDATION_BEFORE_PUSH" = "true" ]; then
  # A delete-only push writes to no branch, so there is no content for a
  # validation result to be about: nothing here is what was, or was not,
  # validated. A protected branch among the deletions has already been
  # refused above, so what reaches here removes unprotected refs only. Same
  # exemption as the protected-branch usability check above, reusing the
  # same DELETE_ONLY/HAS_ANY_REF this hook already computed rather than a
  # second definition of the shape.
  if [ "$HAS_ANY_REF" = "false" ] || [ "$DELETE_ONLY" = "false" ]; then
    # Was a passing result recorded, against the working tree as it now stands?
    "$ROOT_DIR/.ai-policy/scripts/check-validation.sh"
    # Is that working tree what this push publishes? check-validation.sh cannot
    # answer that: it reads the working tree and a push writes a commit, and
    # tree-fingerprint.sh excludes HEAD on purpose so that committing does not
    # invalidate the pass. This is the only layer that receives the resolved refs.
    printf '%s\n' "$PUSH_REFS" | "$ROOT_DIR/.ai-policy/scripts/check-push-content.sh"
  fi
fi

printf '%s\n' "$PUSH_REFS" | "$ROOT_DIR/.ai-policy/hooks/check-changelog.sh"

exit 0
