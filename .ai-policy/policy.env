PROTECTED_BRANCHES="main master"
REQUIRE_VALIDATION_BEFORE_COMMIT="false"
REQUIRE_VALIDATION_BEFORE_PUSH="true"
VALIDATION_STATE_FILE=".ai-policy/state/validation.status"
VALIDATION_COMMAND="./.ai-policy/scripts/project-validation.sh"

# Which files report-suite-size.sh counts as this repository's checks. Absent,
# it uses conventional test locations and says so. Declare it where the checks
# do not follow those conventions, or the reported number quietly omits them.
# SUITE_PATHS=""

# The SessionStart drift-reminder hook (check-context-drift.sh) fires when the
# context file has not been touched in this many commits. Assigned conditionally
# so a caller (or the hook's test) can override via the environment.
: "${CONTEXT_DRIFT_THRESHOLD:=10}"
: "${CONTEXT_FILE:=project-context.md}"
: "${HIDDEN_CLUTTER_THRESHOLD:=5}"

# The SessionStart file-growth hook (check-file-growth.sh) notes committed text files
# of at least FILE_GROWTH_LINES lines that grew by FILE_GROWTH_MIN lines or more over
# the last FILE_GROWTH_WINDOW commits. FILE_GROWTH_EXCLUDE lists globs for files that
# grow by design. A north-star.md declaring `Horizon: one-shot` silences it.
: "${FILE_GROWTH_LINES:=1000}"
: "${FILE_GROWTH_MIN:=50}"
: "${FILE_GROWTH_WINDOW:=50}"
: "${FILE_GROWTH_EXCLUDE:=*.lock *-lock.json *-lock.yaml *.min.js *.min.css CHANGELOG*}"
